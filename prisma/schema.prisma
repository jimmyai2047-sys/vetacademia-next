generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==================== AUTH & USERS ====================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  role          String    @default("STUDENT")
  banned        Boolean   @default(false)
  emailVerified      Boolean  @default(false)
  passwordResetNonce String?
  phone         String?
  institution   String?
  programme     String?
  year          String?
  avatar        String?
  surname           String?
  college            String?
  university         String?
  address            String?
  highestDegree      String?
  expertDesignation  String?
  subjectDepartment  String?
  specialization     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  progress          UserProgress[]
  mockTestAttempts  MockTestAttempt[]
  studentConsultations Consultation[] @relation("StudentConsultations")
  expertProfile     Expert?
  payments          Payment[]
  studyMaterials    StudyMaterial[]
  flashcardProgress FlashcardProgress[]
  chatMessages      ChatMessage[]
  bookmarks         Bookmark[]
  doubts            Doubt[]

  @@index([role])
}

// ==================== CURRICULUM ====================

model Programme {
  id        String      @id @default(cuid())
  name      String
  fullName  String
  yearType  String
  icon      String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  departments Department[]
  subjects    Subject[]

  @@index([name])
}

model Department {
  id          String    @id @default(cuid())
  name        String
  code        String?
  icon        String?
  programmeId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  programme Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  subjects  Subject[]

  @@index([programmeId])
}

model Subject {
  id            String    @id @default(cuid())
  code          String?
  name          String
  year          String?
  semester      String?
  paper         String?
  creditHours   String?
  icon          String?
  description   String?
  departmentId  String?
  programmeId   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  department    Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  programme     Programme   @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  chapters      Chapter[]
  mockTests     MockTest[]
  studyMaterials StudyMaterial[]
  userProgress  UserProgress[]

  @@index([programmeId])
  @@index([departmentId])
}

model Chapter {
  id          String    @id @default(cuid())
  title       String
  content     String
  unitNumber  Int
  courseCode  String?
  creditHours String?
  type        String?
  subjectId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapterContents ChapterContent[]
  studyMaterials StudyMaterial[]

  author   String? // content author / contributor (display only)
  reviewer String? // subject-matter reviewer who verified the content

  @@index([subjectId])
}

// ==================== BOOKMARKS (saved items) ====================
// Lets students save chapters, study materials, questions and papers for
// quick revision. One entry per (user, type, refId) to avoid duplicates.

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  type      String // "chapter" | "material" | "question" | "paper"
  refId     String // id of the bookmarked item
  title     String // denormalized label for display
  url       String // deep link back to the item
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([userId, type, refId])
}

// ==================== OTP CHALLENGES ====================
// Restored to match the existing table so the auth/OTP code compiles and the
// data is preserved (it was previously removed from the schema).

model OtpChallenge {
  id        String   @id @default(cuid())
  contact   String
  purpose   String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contact, purpose])
}

// ==================== NOTIFICATIONS ====================
// Restored to match the existing table so the notifications API compiles and
// the data is preserved.

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  title     String
  body      String
  type      String   @default("GENERAL")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ==================== EXAM PREPARATION STUDY MATERIALS ====================
// Uploaded study resources for exam-prep students, tagged by prep category
// (VO | LSA | ARS | ICAR_ENTRANCE) and resource type.

model ExamMaterial {
  id          String   @id @default(cuid())
  category    String // VO | LSA | ARS | ICAR_ENTRANCE | NET
  type        String // PPT | PDF | VIDEO | AUDIO | ANIMATION | IMAGE
  title       String
  description String?
  body        String? // rich HTML chapter content (pasted from Word, cleaned)
  fileUrl     String? // uploaded file (Blob URL)
  fileName    String?
  fileType    String?
  fileSize    Int?
  externalUrl String? // for video/audio embeds (YouTube, etc.)
  published   Boolean  @default(true)
  isDemo      Boolean  @default(false) // demo content visible to everyone (no purchase)
  order       Int      @default(0)
  subject     String? // Subject name (e.g. "Anatomy") — UG (B.V.Sc/AHDP) or PG (M.V.Sc)
  topic       String? // Chapter / Unit (UG) or Course (PG) title within the subject
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([type])
  @@index([subject])
}

// ==================== MOCK TESTS ====================

model MockTest {
  id          String    @id @default(cuid())
  title       String
  description String?
  duration    Int
  totalMarks  Int
  subjectId   String?
  fileUrl     String?
  fileName    String?
  fileType    String?
  exam        String? // exam key the test belongs to (psc | icar-entrance | net | ars | other)
  track       String? // granular content track (veterinary-officer | livestock-assistant | icar-pre | icar-mains | ...)
  isAdaptive  Boolean  @default(false) // true => adaptive test (vs standard mock test)
  kind        String   @default("MOCK") // MOCK | ADAPTIVE | PREVIOUS_YEAR
  year        String?  // exam year for PREVIOUS_YEAR papers (e.g. "2023")
  examSubjectSlug String? // discipline/subject tag for exam-prep mock tests
  planSlug    String?  // if set, the test is premium and requires this paid plan
  isDemo      Boolean  @default(false) // demo content visible to everyone (no purchase)
  createdAt   DateTime @default(now())
  updatedAt   DateTime  @updatedAt

  subject   Subject?          @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  questions Question[]
  attempts  MockTestAttempt[]

  @@index([subjectId])
  @@index([planSlug])
  @@index([exam])
  @@index([track])
}

// ==================== GENERIC POSTS (Farmers / Vets / Advisory / Previous Year Papers) ====================

model Post {
  id        String   @id @default(cuid())
  category  String // FARMERS | VETS | ADVISORY | PREVIOUS_YEAR
  title     String
  content   String? // rich HTML
  fileUrl   String?
  fileName  String?
  fileType  String?
  fileSize  Int?
  exam      String? // for PREVIOUS_YEAR: psc | icar-entrance | net | ars | other
  track     String? // granular content track (veterinary-officer | livestock-assistant | icar-pre | icar-mains | ...)
  examSubjectSlug String? // discipline/subject within the exam (e.g. veterinary-anatomy)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime  @updatedAt

  @@index([category])
  @@index([exam])
  @@index([track])
}

// ==================== FARMERS CONTENT ====================
// Admin-managed informational content for livestock farmers.

// Scientific-farming guides grouped by farm type (Dairy, Goat, Sheep,
// Poultry, Pig, generic Scientific).
model FarmGuide {
  id        String   @id @default(cuid())
  category  String // SCIENTIFIC | DAIRY | GOAT | SHEEP | POULTRY | PIG
  title     String
  summary   String?
  content   String? // rich HTML
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([published])
}

// Vaccination calendar (separate admin-managed section).
model VaccinationSchedule {
  id        String   @id @default(cuid())
  disease   String
  animals   String // e.g. "Cattle, Buffalo"
  firstDose String
  booster   String
  annual    String
  vaccine   String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Deworming calendar (separate admin-managed section).
model DewormingSchedule {
  id        String   @id @default(cuid())
  animal    String
  firstDose String
  frequency String
  bestTime  String
  products  String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Paid project reports. A teaser/demo is visible to everyone; the full
// report is unlocked after the farmer pays (test mode until Razorpay live).
model ProjectReport {
  id          String   @id @default(cuid())
  title       String
  farmType    String // SCIENTIFIC | DAIRY | GOAT | SHEEP | POULTRY | PIG
  summary     String? // short teaser shown to all
  demoContent String? // visible free (sample section)
  fullContent String? // unlocked after payment
  price       Int      @default(99) // INR
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([farmType])
  @@index([published])
}

// ==================== VISITOR STATS ====================

model SiteVisit {
  id        String   @id @default(cuid())
  visitorId String
  lastSeen  DateTime @default(now())

  @@index([lastSeen])
  @@index([visitorId])
}

model SiteCounter {
  id    String @id @default("total")
  total Int    @default(0)
}

model Question {
  id            String    @id @default(cuid())
  text          String
  options       String
  correctAnswer Int
  marks         Int       @default(1)
  explanation   String?
  difficulty    Int?      @default(2) // 1 = easy, 2 = medium, 3 = hard (for adaptive tests)
  mockTestId    String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  mockTest MockTest @relation(fields: [mockTestId], references: [id], onDelete: Cascade)

  @@index([mockTestId])
}

model MockTestAttempt {
  id          String    @id @default(cuid())
  userId      String
  mockTestId  String
  score       Int
  totalMarks  Int
  answers     String
  timeTaken   Int
  completed   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mockTest MockTest @relation(fields: [mockTestId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([mockTestId])
}

// ==================== CHAPTER CONTENT (admin uploads) ====================

model ChapterContent {
  id           String   @id @default(cuid())
  chapterId    String
  title        String
  fileType     String
  fileName     String
  url          String
  size         Int?
  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId])
}

// ==================== STUDY MATERIALS ====================

model StudyMaterial {
  id          String    @id @default(cuid())
  title       String
  type        String
  url         String?
  fileName    String?
  fileType    String?
  content     String?
  subjectId   String?
  chapterId   String?
  userId      String?
  isPublic    Boolean   @default(true)
  isDemo      Boolean   @default(false) // demo content visible to everyone (no purchase)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  chapter Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([subjectId])
  @@index([chapterId])
  @@index([userId])
  @@index([isPublic])
}

// ==================== FLASHCARDS ====================

model FlashcardProgress {
  id            String    @id @default(cuid())
  userId        String
  subjectId     String
  chapterId     String?
  cardIndex     Int
  known         Boolean   @default(false)
  nextReview    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([subjectId])
}

model Flashcard {
  id         String   @id @default(cuid())
  front      String // term / question shown first
  back       String // answer / explanation on flip
  hint       String?
  subjectId  String?
  chapterId  String?
  tag        String? // topic / category
  difficulty Int?    @default(2) // 1 easy, 2 medium, 3 hard
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([subjectId])
  @@index([chapterId])
  @@index([tag])
}

model Doubt {
  id         String   @id @default(cuid())
  userId     String
  subject    String?
  question   String
  status     String   @default("OPEN") // OPEN | ANSWERED
  answer     String?
  answeredBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==================== ADMISSION ENQUIRIES ====================
// Lead/enrolment form submissions captured from the public /admission page.
// Mirrors the offline admission form (name, parent details, category, TSP,
// qualification) while adding VetAcademia-specific context (programme, year).

model Enquiry {
  id              String   @id @default(cuid())
  fullName        String
  fatherName      String?
  motherName      String?
  dob             String?
  gender          String?
  email           String
  studentMobile   String?
  parentMobile    String?
  address         String?
  programme       String?
  yearOrSemester  String?
  qualification   String?
  percentage      String?
  passingYear     String?
  category        String?
  tsp             String?
  message         String?
  status          String   @default("NEW")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([email])
  @@index([createdAt])
}

// ==================== CONSULTATIONS ====================

model Expert {
  id              String    @id @default(cuid())
  userId          String    @unique
  specialization  String
  bio             String?
  photoUrl        String?
  hourlyRate      Int
  isAvailable     Boolean   @default(true)
  rating          Float     @default(4.8)
  totalReviews    Int       @default(1000)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  consultations Consultation[]

  @@index([userId])
  @@index([isAvailable])
}

model Testimonial {
  id          String   @id @default(cuid())
  name        String
  exam        String
  programme   String?
  quote       String
  rating      Float    @default(5.0)
  intakeYear  Int?
  isApproved  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isApproved])
  @@index([rating])
}

model BlogPost {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  excerpt       String?
  content       String
  coverImageUrl String?
  author        String   @default("VetAcademia Team")
  tags          String?
  isPublished   Boolean  @default(true)
  publishedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isPublished])
  @@index([publishedAt])
}

model Book {
  id            String   @id @default(cuid())
  title         String
  author        String?
  publisher     String?
  edition       String?
  subject       String
  level         String   @default("General") // AHDP | BVSc | MVSc | PhD | General
  description   String?
  coverImageUrl String?
  isRecommended Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([level])
  @@index([subject])
}

model Consultation {
  id          String    @id @default(cuid())
  studentId   String
  expertId    String
  slot        DateTime
  duration    Int
  status      String    @default("PENDING")
  notes       String?
  rating      Int?
  review      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  student User    @relation("StudentConsultations", fields: [studentId], references: [id], onDelete: Cascade)
  expert  Expert  @relation(fields: [expertId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([expertId])
}

// ==================== PLANS (pricing catalog) ====================

model Plan {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  type          String // COURSE | EXAM
  description   String?
  price         Int      @default(0) // in INR
  programmeSlug String? // for COURSE plans: ahdp | bvsc | mvsc | phd
  examSlug      String? // for EXAM plans: veterinary-officer | livestock-assistant | icar-jrf-srf | net | ars
  year          String? // for YEAR-scoped COURSE plans (BVSc/AHDP): e.g. "3rd Year"
  subjectId     String? // for SUBJECT-scoped COURSE plans (MVSc/PhD): specific Subject
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchases Payment[]

  @@index([year])
  @@index([subjectId])
}

// ==================== PAYMENTS ====================

model Payment {
  id          String    @id @default(cuid())
  userId      String
  amount      Int
  currency    String    @default("INR")
  status      String    @default("PENDING") // PENDING | PAID | FAILED | CANCELLED
  method      String?   // TEST | RAZORPAY
  orderId     String?
  paymentId   String?
  planSlug    String?
  projectReportId String?
  metadata    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan? @relation(fields: [planSlug], references: [slug], onDelete: SetNull)

  @@index([userId])
  @@index([orderId])
  @@index([planSlug])
  @@index([projectReportId])
}

// ==================== COMMUNITY LINKS (WhatsApp / Telegram) ====================

model CommunityLink {
  id        String   @id @default(cuid())
  platform  String // WHATSAPP | TELEGRAM
  category  String // PROGRAMME | EXAM | ROLE
  ref       String // programmeSlug (ahdp|bvsc|mvsc|phd) | examKey (psc|icar-entrance|net|ars|other) | role (STUDENT|EXPERT|...)
  title     String
  url       String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, ref])
}

// ==================== USER PROGRESS ====================

model UserProgress {
  id          String    @id @default(cuid())
  userId      String
  subjectId   String
  progress    Float     @default(0)
  lastAccessed DateTime @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
  @@index([userId])
}

// ==================== LIVE CLASSES ====================

model LiveClass {
  id           String   @id @default(cuid())
  title        String
  description  String?
  exam         String   // "psc" | "icar-entrance" | "net" | "ars" | "other"
  track        String?  // granular: "veterinary-officer" | "icar-jrf-srf" etc.
  subject      String?  // discipline/subject label
  youtubeUrl   String?  // YouTube Live embed URL (for video stream)
  scheduledAt  DateTime // when the class is scheduled
  duration     Int      @default(60) // minutes
  status       String   @default("SCHEDULED") // SCHEDULED | LIVE | ENDED | CANCELLED
  recordingUrl String?  // YouTube recorded video URL (populated after live ends)
  thumbnailUrl String?
  isDemo       Boolean  @default(false)
  planSlug     String?  // premium gating
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  messages ChatMessage[]

  @@index([exam, status])
  @@index([scheduledAt])
}

model ChatMessage {
  id          String   @id @default(cuid())
  liveClassId String
  userId      String
  text        String
  createdAt   DateTime @default(now())

  liveClass LiveClass @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([liveClassId, createdAt])
  @@index([userId])
}

// ==================== SETTINGS ====================

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
