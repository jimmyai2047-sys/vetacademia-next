# ============================================================
# VetAcademia — Environment Template
# Copy to `.env` and fill real values. NEVER commit `.env`.
# ============================================================

# ===== Database (production: Neon / Postgres) =====
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ===== NextAuth.js =====
# IMPORTANT: set NEXTAUTH_URL to your PRODUCTION domain (https://...), not localhost.
NEXTAUTH_URL="https://your-domain.com"
# Generate a strong unique secret per environment: `openssl rand -hex 32`
NEXTAUTH_SECRET="generate-a-strong-random-secret-here"

# ===== Razorpay (Payments) =====
# Use LIVE keys from https://dashboard.razorpay.com/app/keys for production.
# When live keys are present, real Razorpay payments are required (test-mode off).
RAZORPAY_KEY_ID="rzp_live_XXXXXXXXXXXXXXX"
RAZORPAY_KEY_SECRET="XXXXXXXXXXXXXXXXXXXXXXXX"

# ===== Payment test-mode flag (MUST be false in production) =====
# "true" ONLY for local dev to simulate successful payments without Razorpay.
ALLOW_TEST_PAYMENTS=false

# ===== File storage (Vercel Blob) — required for admin uploads =====
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_XXXXXXXXXXXXXXXXXXXX"

# ===== Public app config =====
NEXT_PUBLIC_APP_NAME="VetAcademia"
# Must match the NEXTAUTH_URL origin.
NEXT_PUBLIC_APP_URL="https://your-domain.com"
